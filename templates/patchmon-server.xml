<?xml version="1.0"?>
<Container version="2">
  <Name>patchmon-server</Name>
  <Repository>ghcr.io/patchmon/patchmon-server:latest</Repository>
  <Registry>https://github.com/PatchMon/PatchMon/pkgs/container/patchmon-server</Registry>
  <Network>patchmon</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/PatchMon/PatchMon/issues</Support>
  <Project>https://patchmon.net/</Project>
  <ReadMe>https://github.com/PatchMon/PatchMon#readme</ReadMe>
  <Overview>PatchMon: Linux patch monitoring with agents, a web UI and an agent API (part 4 of 4). Joins the network patchmon to reach its database, redis and guacd by name, and publishes the web UI from there. Install patchmon-database, patchmon-redis and patchmon-guacd first.</Overview>
  <Category>Tools:Utilities Security:</Category>
  <WebUI>http://[IP]:[PORT:3000]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/louij2/unraid-templates/master/templates/patchmon-server.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/selfhst/icons/main/png/patchmon.png</Icon>
  <ExtraParams>--restart=unless-stopped --log-opt max-size=10m --log-opt max-file=3</ExtraParams>
  <PostArgs></PostArgs>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires>Create the network once before installing any PatchMon container: docker network create patchmon. Install in this order: patchmon-database, patchmon-redis, patchmon-guacd, patchmon-server.</Requires>
  <Config Name="Web UI" Target="3000" Default="3001" Mode="tcp" Description="Web UI and agent API." Type="Port" Display="always" Required="true" Mask="false">3001</Config>
  <Config Name="DATABASE_URL" Target="DATABASE_URL" Default="postgresql://patchmon_user:CHANGE_ME@database:5432/patchmon_db" Mode="" Description="postgresql://USER:PASSWORD@database:5432/DB, using the values from patchmon-database." Type="Variable" Display="always" Required="true" Mask="true">postgresql://patchmon_user:CHANGE_ME@database:5432/patchmon_db</Config>
  <Config Name="POSTGRES_HOST" Target="POSTGRES_HOST" Default="database" Mode="" Description="" Type="Variable" Display="advanced" Required="true" Mask="false">database</Config>
  <Config Name="POSTGRES_USER" Target="POSTGRES_USER" Default="patchmon_user" Mode="" Description="Same as patchmon-database." Type="Variable" Display="always" Required="true" Mask="false">patchmon_user</Config>
  <Config Name="POSTGRES_PASSWORD" Target="POSTGRES_PASSWORD" Default="" Mode="" Description="Same as patchmon-database." Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="POSTGRES_DB" Target="POSTGRES_DB" Default="patchmon_db" Mode="" Description="Same as patchmon-database." Type="Variable" Display="always" Required="true" Mask="false">patchmon_db</Config>
  <Config Name="REDIS_HOST" Target="REDIS_HOST" Default="redis" Mode="" Description="" Type="Variable" Display="advanced" Required="true" Mask="false">redis</Config>
  <Config Name="REDIS_PORT" Target="REDIS_PORT" Default="6379" Mode="" Description="" Type="Variable" Display="advanced" Required="true" Mask="false">6379</Config>
  <Config Name="REDIS_DB" Target="REDIS_DB" Default="0" Mode="" Description="" Type="Variable" Display="advanced" Required="true" Mask="false">0</Config>
  <Config Name="REDIS_PASSWORD" Target="REDIS_PASSWORD" Default="" Mode="" Description="Same as patchmon-redis." Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="GUACD_ADDRESS" Target="GUACD_ADDRESS" Default="guacd:4822" Mode="" Description="guacd host:port." Type="Variable" Display="advanced" Required="true" Mask="false">guacd:4822</Config>
  <Config Name="JWT_SECRET" Target="JWT_SECRET" Default="" Mode="" Description="Generate one, e.g. openssl rand -hex 64." Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="SESSION_SECRET" Target="SESSION_SECRET" Default="" Mode="" Description="Generate one, e.g. openssl rand -hex 64." Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="AI_ENCRYPTION_KEY" Target="AI_ENCRYPTION_KEY" Default="" Mode="" Description="Generate one, e.g. openssl rand -hex 32." Type="Variable" Display="always" Required="true" Mask="true"></Config>
  <Config Name="CORS_ORIGIN" Target="CORS_ORIGIN" Default="http://YOUR-SERVER-IP:3001" Mode="" Description="Comma-separated URLs you open PatchMon on, e.g. http://192.168.1.10:3001 or your reverse-proxy URL." Type="Variable" Display="always" Required="true" Mask="false">http://YOUR-SERVER-IP:3001</Config>
  <Config Name="TRUST_PROXY" Target="TRUST_PROXY" Default="false" Mode="" Description="true when behind a reverse proxy." Type="Variable" Display="always" Required="false" Mask="false">false</Config>
</Container>
