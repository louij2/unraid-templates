<?xml version="1.0"?>
<Container version="2">
  <Name>semaphore-exporter</Name>
  <Repository>louij2/semaphore-exporter:latest</Repository>
  <Registry>https://hub.docker.com/r/louij2/semaphore-exporter</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/louij2/semaphore-exporter/issues</Support>
  <Project>https://github.com/louij2/semaphore-exporter</Project>
  <ReadMe>https://raw.githubusercontent.com/louij2/semaphore-exporter/master/README.md</ReadMe>
  <Overview>Prometheus exporter for Semaphore (semaphoreui.com), which has no native /metrics endpoint. Read-only: only GETs from Semaphore's API. Exports semaphore_task_running_seconds for every non-terminal task, so a task stuck running for hours shows up, not just failed/succeeded ones.</Overview>
  <Category>Tools:System</Category>
  <WebUI>http://[IP]:[PORT:9819]/metrics</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/louij2/unraid-templates/master/templates/semaphore-exporter.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/semaphoreui/semaphore/develop/web/src/assets/logo.svg</Icon>
  <ExtraParams>--restart=unless-stopped --memory=256m --cpus=0.5</ExtraParams>
  <PostArgs/>
  <CPUset/>
  <DonateText/>
  <DonateLink/>
  <Requires>A Semaphore API token.</Requires>
  <Config Name="Host Port 9819" Target="9819" Default="9819" Mode="tcp" Description="Container Port: 9819" Type="Port" Display="always" Required="true" Mask="false">9819</Config>
  <Config Name="semaphore-token" Target="/run/secrets/semaphore-token" Default="" Mode="ro" Description="Read-only bind mount to a file containing your Semaphore API token." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/semaphore-exporter/semaphore-token</Config>
  <Config Name="SEMAPHORE_URL" Target="SEMAPHORE_URL" Default="" Mode="" Description="e.g. http://10.0.0.24:3000" Type="Variable" Display="always" Required="true" Mask="false"></Config>
</Container>
